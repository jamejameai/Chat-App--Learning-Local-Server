# ==============================================================================
# Mini Telegram - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR SECURE CONFIGURATION VALUES.
# NEVER COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Application Environment (development | production)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME="Mini Telegram"
APP_URL=http://localhost:3000

# Super Admin Initial Setup
# Used by initial seed migration if no super-admin exists
SUPERADMIN_INVITE_CODE=invite_master_init_00000000

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=minitelegram
DB_PASSWORD=change_this_to_a_secure_database_password
DB_NAME=minitelegram_db
DB_SSL=false

# JWT & Session Security
# Generate secure random strings with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_64_char_cryptographically_secure_random_string_access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_64_char_cryptographically_secure_random_string_refresh
JWT_REFRESH_EXPIRES_IN=30d

# Encrypted File / Attachment Storage
# Storage driver: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# Maximum allowed attachment size in bytes (e.g. 52428800 = 50 MB)
MAX_ATTACHMENT_SIZE_BYTES=52428800

# WebRTC & LiveKit SFU Configuration
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_livekit_key_replace_for_production

# Coturn STUN / TURN Relay Configuration
TURN_DOMAIN=turn.example.com
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_SHARED_SECRET=replace_with_turn_shared_secret
TURN_REALM=minitelegram.local

# Apple Push Notification service (APNs)
# APNs keys are provisioned from your Apple Developer Account
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.minitelegram.ios
APNS_PRIVATE_KEY_PATH=
APNS_PRODUCTION=false

# Rate Limiting
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10
